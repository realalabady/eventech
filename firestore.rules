rules_version = '2';

// EvenTech Firestore rules — deny-by-default (guides/50_CANONICAL_DECISIONS.md §7).
// Account role comes from custom claims; org-scoped permissions come from
// organizationMembers lookups. Collections open up phase by phase.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid);
    }

    function isActiveMember(orgId) {
      return isSignedIn()
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.status == 'active';
    }

    // `suspendedReason` and `email` joined this list at Phase 11. Suspension
    // disables the account but an already-issued ID token stays valid for up to
    // an hour (see functions/src/admin/manage-users.ts), so a just-suspended
    // user had a window in which to blank the reason the admin console shows.
    // `email` is what that console lists accounts by, and it is mirrored from
    // Auth — a user editing the mirror only makes the two disagree.
    function protectedUserFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'accountStatus', 'suspendedReason', 'email', 'organizationIds', 'stats', 'createdAt', 'uid']) == false;
    }

    // Phase 2 — Authentication.
    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if false;  // completeOnboarding only
      allow update: if isSelf(userId) && protectedUserFieldsUnchanged();
      allow delete: if false;  // Cloud Function only, so cleanup + audit run
    }

    // Phase 3 — Organizer foundation.
    match /organizations/{orgId} {
      // Public profiles are readable by anyone (canonical §7); verification
      // only grants a badge, it does not gate visibility.
      allow get, list: if true;
      // Every mutation runs through createOrganization / updateOrganization so
      // slug, verified, ownerId and counters cannot be forged.
      allow write: if false;
    }

    // Bank details live here, NOT on the organization document.
    //
    // `organizations` is world-readable so public organizer pages work without
    // auth. Firestore has no field-level read security, so while `payment` sat
    // on that document every organizer's IBAN, bank name and account holder
    // were readable by anyone on the internet with the public web API key —
    // no account required. Moving the field is the only way to scope it.
    //
    // Read is limited to signed-in users because an attendee must see where to
    // transfer, and they are not a member of the organization they are paying.
    // That is still broader than ideal: any authenticated account can read any
    // organization's details. The tighter design is to snapshot these onto the
    // booking document at creation (bookings are already restricted to the
    // attendee plus org members) and drop the read rule to members only. That
    // is a data-model change, deliberately not bundled with this fix.
    match /organizationPayments/{orgId} {
      allow get: if isSignedIn();
      allow list: if false;  // never enumerable, even signed in
      allow write: if false; // updateOrganization only
    }

    match /organizationMembers/{memberId} {
      // Team members see their own roster; an invitee can find the invitation
      // addressed to their email (queries must filter on that email).
      allow get, list: if isSignedIn() && (
        isAdmin()
        || resource.data.email == request.auth.token.email
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId))
      );
      // inviteMember / acceptInvitation / updateMemberRole / removeMember only.
      allow write: if false;
    }

    // Phase 4 — Event management.
    match /events/{eventId} {
      // Published events are public; drafts stay inside the organization.
      allow get, list: if resource.data.status == 'published'
        || isAdmin()
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId));
      // createEvent / saveEventDraft / publishEvent only — status, slug,
      // capacity and sold counts must never be client-writable.
      allow write: if false;
    }

    match /venues/{venueId} {
      allow get, list: if true;
      allow write: if false;  // createVenue only
    }

    match /artists/{artistId} {
      allow get, list: if true;
      allow write: if false;  // createArtist only
    }

    // Phase 6 — Booking. Receipts are financial documents, so a booking is
    // visible only to the attendee who made it and the organizers reviewing it.
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.attendeeId == request.auth.uid
        || isAdmin()
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId))
      );
      // Queries must filter by attendeeId or organizationId; both branches are
      // enforced per returned document.
      allow list: if isSignedIn() && (
        resource.data.attendeeId == request.auth.uid
        || isAdmin()
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId))
      );
      // createBooking / submitReceipt / approveBooking / rejectBooking /
      // cancelBooking only. Status, amount and inventory are never client-set.
      allow write: if false;
    }

    // Phase 7 — Tickets & check-in. A ticket carries the QR token, so reading it
    // is equivalent to holding the ticket: the owner and the event's door staff,
    // nobody else. Status only ever changes inside checkInTicket.
    match /tickets/{ticketId} {
      allow get, list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || isAdmin()
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId))
      );
      // generateTicket / checkInTicket only.
      allow write: if false;
    }

    // Attendance records belong to the organization, not the attendee — they
    // are operational data for the door, and they never change after the scan.
    match /checkins/{checkinId} {
      allow get, list: if isSignedIn() && (
        isAdmin()
        || (resource.data.organizationId is string
            && isActiveMember(resource.data.organizationId))
      );
      allow write: if false;  // checkInTicket only
    }

    match /timeline/{itemId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      allow write: if false;
    }

    // Phase 8b — Calendar + team communication. All three are org-scoped
    // production data: any active member reads, nobody writes from the client.
    match /calendarEvents/{entryId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      // createCalendarEvent / updateCalendarEvent / deleteCalendarEvent only.
      allow write: if false;
    }

    match /channels/{channelId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      allow write: if false;  // createChannel only
    }

    // Messages carry their channel's organizationId, so a read can be scoped
    // without a second lookup — rules cannot follow the channel reference
    // cheaply, and a per-message get() would be billed on every document.
    match /messages/{messageId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      allow write: if false;  // sendMessage only
    }

    // Phase 9c — moderation queue and platform configuration.

    // Reports are write-only from the client's side. A reporter never reads the
    // queue back — not even their own submissions — because the queue exposes
    // who reported whom, which is exactly what makes retaliation possible.
    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow write: if false;  // submitReport / resolveReport only
    }

    // Feature flags gate UI for everyone, including signed-out visitors on the
    // marketing pages, so they must be world-readable. Nothing secret goes in
    // here — a flag name and a boolean are visible to anyone who looks.
    match /featureFlags/{document} {
      allow get, list: if true;
      allow write: if false;  // setFeatureFlag only
    }

    // Platform settings are read by the booking form (ticket limits) and the
    // footer (support address), so they are public too. `updateSystemSettings`
    // writes only an allowlisted set of keys for that reason.
    match /systemSettings/{document} {
      allow get, list: if true;
      allow write: if false;  // updateSystemSettings only
    }

    match /activityLogs/{logId} {
      allow get, list: if isSignedIn()
        && resource.data.organizationId is string
        && isActiveMember(resource.data.organizationId);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;  // server-side only, never client-readable
    }

    // Phase 11 — rate limiting. Counters are written by enforceRateLimit with
    // the Admin SDK, which bypasses these rules. Stated explicitly rather than
    // left to the catch-all below: a client that could read its own counter
    // learns exactly when its budget resets, and one that could write would
    // simply erase it.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Everything else stays denied until its phase lands.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
