rules_version = '2';

// EvenTech Storage rules — deny-by-default (guides/50_CANONICAL_DECISIONS.md §7).
//
// Ownership is expressed through the PATH rather than by reading Firestore from
// these rules. Cross-service rules would cost a Firestore read on every upload
// and depend on the Storage service agent holding Firestore permissions, which
// is an extra failure mode. Instead each writable path is namespaced by the
// uploader's uid, and the Cloud Function that records the resulting URL is what
// enforces the real authorization: it verifies organization membership and that
// the URL points at the expected prefix before persisting it. An upload that
// skips that step is orphaned and can never be referenced by the app.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isReceiptFile() {
      return isImage() || request.resource.contentType == 'application/pdf';
    }

    // 20 MB ceiling (canonical §7).
    function withinSizeLimit() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // Organization logo and cover: world-readable, written under the uploader's
    // uid. updateOrganization checks owner/manager before storing the URL.
    match /organizations/{orgId}/{imageType}/{userId}/{fileName} {
      allow read: if true;
      allow write: if imageType in ['logo', 'cover']
        && isOwner(userId)
        && isImage()
        && withinSizeLimit();
    }

    // Event cover: world-readable, same pattern. saveEventDraft checks
    // owner/manager and the URL prefix before storing it.
    match /events/{eventId}/cover/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && withinSizeLimit();
    }

    // Transfer receipts are financial documents and are NEVER world-readable.
    // Only the attendee who uploaded one can read it back through the rules.
    // Organizers reach it through the tokenised download URL recorded on the
    // booking, and that booking document is itself readable only by the
    // attendee and the organization's members (see firestore.rules).
    match /events/{eventId}/receipts/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isReceiptFile() && withinSizeLimit();
    }

    // QR images are never world-readable (canonical §7) and are never written
    // from a browser — generateTicket writes them with the Admin SDK, which
    // bypasses these rules. Reads go through the tokenised URL recorded on the
    // ticket document, which only the owner and the door staff can read.
    match /tickets/{ticketId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
