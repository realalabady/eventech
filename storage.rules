rules_version = '2';

// EvenTech Storage rules — deny-by-default (guides/50_CANONICAL_DECISIONS.md §7).
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // 20 MB ceiling (canonical §7).
    function withinSizeLimit() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    function canManageOrg(orgId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.role in ['owner', 'manager'];
    }

    // Organization logo and cover: world-readable, owner/manager to write.
    match /organizations/{orgId}/{imageType}/{fileName} {
      allow read: if true;
      allow write: if imageType in ['logo', 'cover']
        && canManageOrg(orgId)
        && isImage()
        && withinSizeLimit();
    }

    // Event cover: public to read, writable by owners/managers of the
    // organization that owns the event. The event document is the only link
    // between the file path and the membership record, so it is read here.
    function canManageEvent(eventId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && firestore.exists(/databases/(default)/documents/organizationMembers/$(firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizationId + '_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizationMembers/$(firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizationId + '_' + request.auth.uid)).data.role in ['owner', 'manager'];
    }

    match /events/{eventId}/cover/{fileName} {
      allow read: if true;
      allow write: if canManageEvent(eventId) && isImage() && withinSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
