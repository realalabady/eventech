# Firebase client SDK (from Firebase Console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed if Firebase Analytics is switched on.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local development — set to "true" to use Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# App Check (Phase 11). Leave blank locally: without a key App Check is skipped
# entirely, which is what keeps a fresh clone and the emulator suite working.
# The site key is the reCAPTCHA v3 key from Firebase Console → App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Debug token for a developer machine, registered in Firebase Console → App
# Check → Apps → Manage debug tokens. NEVER set this in a production build:
# anyone holding it bypasses attestation completely.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Server-only secrets (Cloud Functions / server runtime — NEVER exposed to the client)
RESEND_API_KEY=
